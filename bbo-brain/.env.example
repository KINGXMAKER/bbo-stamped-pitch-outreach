# BBO BRAIN reads the repo-root ../.env first, then this directory's .env.local.
# Nothing here is ever exposed to the browser (no NEXT_PUBLIC_ variables).

# Composio — the Instagram connected account lives behind this key.
COMPOSIO_API_KEY=
COMPOSIO_INSTAGRAM_CONNECTED_ACCOUNT_ID=ca_xH0r_E3tatzk
COMPOSIO_USER_ID=bbo_user
INSTAGRAM_IG_USER_ID=26850983357863398

# AI — Gemini is primary; the fallbacks are tried in order on transient / model-unavailable errors.
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-2.0-flash

# Local transcription (whisper.cpp). Leave unset to skip transcript ingestion.
WHISPER_CLI=/opt/homebrew/bin/whisper-cli
WHISPER_MODEL=/Users/ulysses/.agents/tools/whisper-models/ggml-base.en.bin

# Storage
BRAIN_DB_PATH=
BRAIN_MEDIA_DIR=

# Optional access gate. When set, every page and API route requires this password.
BRAIN_ACCESS_PASSWORD=
