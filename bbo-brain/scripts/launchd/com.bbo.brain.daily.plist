<?xml version="1.0" encoding="UTF-8"?>
<!--
  TEMPLATE — not installed. Runs the BBO BRAIN daily loop at 07:30 local time.
  Install (only when you decide to):
    cp scripts/launchd/com.bbo.brain.daily.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.bbo.brain.daily.plist
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.bbo.brain.daily.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bbo.brain.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/ulysses/bbo-stamped-pitch/bbo-brain &amp;&amp; npm run -s job -- daily &gt;&gt; data/daily.log 2&gt;&amp;1 &amp;&amp; npm run -s job -- weekly-review &gt;&gt; data/daily.log 2&gt;&amp;1</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardErrorPath</key>
  <string>/Users/ulysses/bbo-stamped-pitch/bbo-brain/data/launchd.err</string>
</dict>
</plist>
